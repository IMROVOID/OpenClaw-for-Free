{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    "outDir": "./dist"
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "launchers/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "bin",
    "_bmad",
    ".agents"
  ]
}
