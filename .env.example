# ==============================================================================
# OpenClaw-for-free Environment Configuration Template
# ==============================================================================

# Telegram Bot Credentials (Required for src/telegram-bot)
# Obtain bot token from @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=123456789:your_telegram_bot_token_from_botfather

# Numeric Telegram User ID of the primary owner / administrator.
# Obtain from @userinfobot. Used by authMiddleware to lock administrative commands.
TELEGRAM_OWNER_ID=123456789

# Multi-User & Access Control (Optional)
# Set to 'true' to allow non-owner users to access isolated public bot features.
# Default: false (restricted strictly to TELEGRAM_OWNER_ID)
TELEGRAM_PUBLIC_BOT=false

# User Storage & Database Configuration (Optional)
# Directory where user state and SQLite databases are stored:
TELEGRAM_DATA_DIR=./data/telegram

# Explicit path to the user storage SQLite database:
# Default: ${TELEGRAM_DATA_DIR}/user_storage.db
TELEGRAM_DB_PATH=./data/telegram/user_storage.db

# Master AES-256 Encryption Key (Optional)
# Used to encrypt sensitive tokens in user databases.
# If omitted, a persistent key is automatically derived from hardware machine ID.
OPENCLAW_DATA_ENCRYPTION_KEY=your-secure-32-byte-encryption-key-here
